{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ROS 2: Build",
            "type": "shell",
            "command": "colcon build --symlink-install --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "ROS 2: Build Debug",
            "type": "shell",
            "command": "colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
            "problemMatcher": []
        },
        {
            "label": "ROS 2: Run",
            "type": "shell",
            "command": ". install/setup.bash && ros2 run hello_ros2 hello_node",
            "problemMatcher": []
        },
        {
            "label": "ROS 2: Test",
            "type": "shell",
            "command": "colcon test && colcon test-result --verbose",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "ROS 2: Clean",
            "type": "shell",
            "command": "rm -rf build install log",
            "problemMatcher": []
        },
        {
            "label": "GUI: Display Check (xeyes)",
            "type": "shell",
            "command": "xeyes",
            "problemMatcher": []
        },
        {
            "label": "GUI: RViz2",
            "type": "shell",
            "command": "rviz2",
            "problemMatcher": []
        }
    ]
}
