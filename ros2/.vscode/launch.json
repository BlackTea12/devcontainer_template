{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ROS 2: Debug hello_node",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/hello_ros2/lib/hello_ros2/hello_node",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "ROS 2: Build Debug",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for GDB",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
